# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UPLOAD_DIR=/app/shared/uploads
PROCESSED_DIR=/app/shared/processed
TEMP_DIR=/app/shared/temp
MAX_FILE_SIZE=524288000  # 500MB in bytes
VIDEO_EXPIRY_HOURS=24

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# OpenPose Configuration
OPENPOSE_MODEL=BODY_25
OPENPOSE_NET_RESOLUTION=-1x368
OPENPOSE_RENDER_THRESHOLD=0.05
USE_GPU=false  # Set to true if you have NVIDIA GPU and nvidia-docker installed

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_POLLING_INTERVAL=2000  # Polling interval in milliseconds

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
